# Safe example only. OS environment values override project-local .env values.
OPENAI_API_KEY=
PICKYLENS_PROVIDER=openai
PICKYLENS_MODEL=gpt-5.6-sol
PICKYLENS_REASONING_EFFORT=low
PICKYLENS_DB_PATH=data/pickylens.sqlite3
PICKYLENS_API_TIMEOUT_SECONDS=120
PICKYLENS_ENV=development
# Judge Pass values are process environment settings (systemd on VESTA).
PICKYLENS_ACCESS_DB=data/judge-access.sqlite3
PICKYLENS_GLOBAL_OPERATIONS=200
PICKYLENS_OPERATIONS_PER_MINUTE=6

PICKYLENS_GLOBAL_TOKEN_BUDGET=2000000

# Anonymous Web only; extension access still requires a Judge Pass.
PICKYLENS_ANONYMOUS_OPERATIONS=12
PICKYLENS_ANONYMOUS_HOURS=24
PICKYLENS_ANONYMOUS_PER_MINUTE=6
PICKYLENS_ANONYMOUS_IP_OPERATIONS=30

# Traffic classification only; never extension authentication.
PICKYLENS_ANONYMOUS_IP_HOURS=24
PICKYLENS_DEVPOST_OPERATIONS=30
PICKYLENS_DEVPOST_HOURS=72
PICKYLENS_DEVPOST_PER_MINUTE=6
PICKYLENS_DEVPOST_IP_OPERATIONS=60
PICKYLENS_DEVPOST_IP_HOURS=72
