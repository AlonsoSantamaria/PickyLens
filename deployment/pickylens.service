[Unit]
Description=PickyLens controlled live evaluation demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pickylens
Group=pickylens
WorkingDirectory=/srv/neovantia/apps/pickylens
EnvironmentFile=/etc/neovantia/secrets/pickylens/runtime.env
ExecStart=/srv/neovantia/apps/pickylens/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8062 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/neovantia/pickylens
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
