{
  "manifest_version": 3,
  "name": "PickyLens feasibility probe",
  "version": "0.0.1",
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "gemini-host.js",
        "lifecycle.js",
        "probe.js"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  }
}